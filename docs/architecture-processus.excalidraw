      "updated": 1792195200000,
      "link": null,
      "locked": false,
      "text": "schedule () → kernel_signal_dispatch (current)\nordre : plus petit numéro d'abord\naction par défaut : terminer (do_exit, code 128 + sig),\n                    stopper, ou ignorer\nhandler noyau (kthread) : appelé directement\nhandler ring 3 : laissé en attente pour le chemin B",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "schedule () → kernel_signal_dispatch (current)\nordre : plus petit numéro d'abord\naction par défaut : terminer (do_exit, code 128 + sig),\n                    stopper, ou ignorer\nhandler noyau (kthread) : appelé directement\nhandler ring 3 : laissé en attente pour le chemin B",
      "autoResize": true,
      "lineHeight": 1.25
    },
