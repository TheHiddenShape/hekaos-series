      "seed": 1943854098,
      "version": 1,
      "versionNonce": 224036670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792195200000,
      "link": null,
      "locked": false,
      "text": "  1  exit       do_exit\n  2  fork       task_fork\n  3  read       fd 0 ← in_buf (pfeed)\n  4  write      fd 1, 2 → log_buf\n  7  waitpid    bloque, puis task_reap\n 37  kill       kernel_signal_send\n 48  signal     kernel_signal_register\n119  sigreturn  restaure le contexte\n199  getuid     current->uid\n201  geteuid    current->euid",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  1  exit       do_exit\n  2  fork       task_fork\n  3  read       fd 0 ← in_buf (pfeed)\n  4  write      fd 1, 2 → log_buf\n  7  waitpid    bloque, puis task_reap\n 37  kill       kernel_signal_send\n 48  signal     kernel_signal_register\n119  sigreturn  restaure le contexte\n199  getuid     current->uid\n201  geteuid    current->euid",
      "autoResize": true,
      "lineHeight": 1.25
    },
