    {
      "id": "7SBZ3V7K0YDjO8tjBw3b",
      "type": "text",
      "x": 1502,
      "y": 2135.75,
      "width": 319.2,
      "height": 175.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "-sDut4BVJjuDMTZoXW4p"
      ],
      "frameId": null,
