    {
      "id": "cBKUnz6bWw0CnQW48E_X",
      "type": "text",
      "x": 42,
      "y": 2269.5,
      "width": 504.0,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6DT7nLAwLLaLp0Ld-3ms"
      ],
