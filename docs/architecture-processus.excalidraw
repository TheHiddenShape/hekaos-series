    {
      "id": "g5JQqg1OSzPwN3d9-Hc4",
      "type": "text",
      "x": 1402,
      "y": 1325.5,
      "width": 711.0,
      "height": 168.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vskbEtMQEFWq5AtoQwX7"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 895881654,
      "version": 1,
      "versionNonce": 1974561164,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792195200000,
      "link": null,
      "locked": false,
      "text": "1. pid_alloc ()                     ⚠ PID jamais recyclés : plus rien après 127\n2. kmalloc (sizeof (struct task))   244 octets pour une limite de 256\n3. pile noyau : 2 pages à 0xEF000000 + pid × 8 Kio\n4. paging_proc_init (pid) : nouveau page directory, partie noyau copiée du PD 0\n5. contenu : code du kthread · image ring 3 · copie de l'espace du parent\n6. trap frame en haut de la pile noyau → thread.tf, thread.esp\n   (forgé par exec_fn et spawn_user, copié par fork)\n7. task_add_child (parent) puis insertion en tête de task_list_head\n8. state = RUNNABLE",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. pid_alloc ()                     ⚠ PID jamais recyclés : plus rien après 127\n2. kmalloc (sizeof (struct task))   244 octets pour une limite de 256\n3. pile noyau : 2 pages à 0xEF000000 + pid × 8 Kio\n4. paging_proc_init (pid) : nouveau page directory, partie noyau copiée du PD 0\n5. contenu : code du kthread · image ring 3 · copie de l'espace du parent\n6. trap frame en haut de la pile noyau → thread.tf, thread.esp\n   (forgé par exec_fn et spawn_user, copié par fork)\n7. task_add_child (parent) puis insertion en tête de task_list_head\n8. state = RUNNABLE",
      "autoResize": true,
      "lineHeight": 1.25
    },
